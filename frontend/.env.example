# Copy to .env.local and adjust if needed.
# Anvil default chain id and RPC (used when adding the network to MetaMask)
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
# Use mock data and browser-side mock sign-in until the backend gateway API is ready
VITE_USE_MOCK=true

# Contract addresses. Empty = the addresses DeployCareConsent.s.sol produces as the first
# deployment on a fresh Anvil. Set them to the addresses the deploy script prints otherwise.
VITE_RECORD_REGISTRY_ADDRESS=
VITE_CONSENT_MANAGER_ADDRESS=
VITE_RESEARCH_SETTLEMENT_ADDRESS=

@prefix cc:   <https://careconsent.example/ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<https://careconsent.example/ns> a owl:Ontology ;
    dct:title "CareConsent health-record ontology"@en ;
    dct:description "Small OWL/RDFS vocabulary for synthetic FHIR R4 chronic-care records. It describes recorded statements; it does not make them verified medical facts."@en ;
    owl:versionInfo "0.2.0" .

# ---- Core classes (names follow the proposal's entities) ----
cc:PatientProfile a owl:Class ; rdfs:label "Patient profile"@en ;
    rdfs:comment "Synthetic patient identifier. Contains no real identity."@en .
cc:HealthRecordVersion a owl:Class, rdfs:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "Health record version"@en ;
    rdfs:comment "Immutable version of one FHIR resource. Its IRI is built from the opaque on-chain versionId (64 hex chars)."@en .
cc:ConditionRecord a owl:Class ; rdfs:subClassOf cc:HealthRecordVersion ; rdfs:label "Condition record"@en .
cc:MedicationStatementRecord a owl:Class ; rdfs:subClassOf cc:HealthRecordVersion ; rdfs:label "Medication statement record"@en .
cc:AllergyRecord a owl:Class ; rdfs:subClassOf cc:HealthRecordVersion ; rdfs:label "Allergy record"@en .
cc:ObservationRecord a owl:Class ; rdfs:subClassOf cc:HealthRecordVersion ; rdfs:label "Observation record (symptom or exercise)"@en .
cc:TerminologyConcept a owl:Class, skos:Concept ; rdfs:label "Terminology concept"@en ;
    rdfs:comment "Versioned concept. conceptOrigin distinguishes 'standard' from 'local-demo' concepts."@en .

# ---- Provenance of query results (PROV-O) ----
cc:QueryActivity a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Query activity"@en ;
    rdfs:comment "One execution of a predefined template on a temporary consent-scoped dataset; prov:used points at the source versions."@en .
cc:QueryResult a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Query result"@en ;
    rdfs:comment "Projected result; prov:wasGeneratedBy a QueryActivity and prov:wasDerivedFrom each source version."@en .
cc:templateId a owl:DatatypeProperty ; rdfs:domain cc:QueryActivity ; rdfs:range xsd:string .

# ---- Object properties ----
cc:subject a owl:ObjectProperty ; rdfs:domain cc:HealthRecordVersion ; rdfs:range cc:PatientProfile .
cc:concept a owl:ObjectProperty ; rdfs:domain cc:HealthRecordVersion ; rdfs:range cc:TerminologyConcept ;
    rdfs:comment "Coded meaning of the record (condition, allergen, medication or observation type)."@en .
cc:replacesVersion a owl:ObjectProperty ; rdfs:domain cc:HealthRecordVersion ; rdfs:range cc:HealthRecordVersion ;
    rdfs:comment "Correction link; mirrors replacesVersionId in RecordRegistry. Earlier version stays unchanged."@en .

# ---- Datatype properties: record metadata ----
cc:resourceType a owl:DatatypeProperty ; rdfs:range xsd:string .
cc:sourceResource a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:comment "FHIR reference, e.g. MedicationStatement/ms04."@en .
cc:recordedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; rdfs:comment "FHIR meta.lastUpdated (UTC)."@en .
cc:status a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:comment "FHIR clinicalStatus / status code."@en .
cc:verificationStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
cc:birthDate a owl:DatatypeProperty ; rdfs:domain cc:PatientProfile ; rdfs:range xsd:date .
cc:onsetAt a owl:DatatypeProperty ; rdfs:domain cc:ConditionRecord .
cc:periodStart a owl:DatatypeProperty ; rdfs:domain cc:MedicationStatementRecord ; rdfs:range xsd:dateTime .
cc:periodEnd a owl:DatatypeProperty ; rdfs:domain cc:MedicationStatementRecord ; rdfs:range xsd:dateTime ;
    rdfs:comment "Absent = ongoing / open-ended. Closed bound (FHIR Period.end is inclusive)."@en .
cc:observationKind a owl:DatatypeProperty ; rdfs:domain cc:ObservationRecord ; rdfs:range xsd:string ;
    rdfs:comment "'symptom', 'exercise' or 'other', derived from Observation.category at import."@en .
cc:effectiveAt a owl:DatatypeProperty ; rdfs:domain cc:ObservationRecord ; rdfs:range xsd:dateTime .
cc:valueQuantity a owl:DatatypeProperty ; rdfs:domain cc:ObservationRecord ; rdfs:range xsd:decimal .
cc:unit a owl:DatatypeProperty ; rdfs:domain cc:ObservationRecord ; rdfs:range xsd:string ;
    rdfs:comment "Stored as recorded; units are never converted."@en .

# ---- Terminology concept properties ----
cc:code a owl:DatatypeProperty ; rdfs:domain cc:TerminologyConcept ; rdfs:range xsd:string .
cc:label a owl:DatatypeProperty ; rdfs:domain cc:TerminologyConcept ; rdfs:range xsd:string .
cc:system a owl:ObjectProperty ; rdfs:domain cc:TerminologyConcept .
cc:conceptOrigin a owl:DatatypeProperty ; rdfs:domain cc:TerminologyConcept ; rdfs:range xsd:string .
cc:catalogueVersion a owl:DatatypeProperty ; rdfs:domain cc:TerminologyConcept ; rdfs:range xsd:string .
